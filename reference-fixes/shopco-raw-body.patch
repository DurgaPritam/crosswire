--- a/app/test/webhooks.test.js
+++ b/app/test/webhooks.test.js
@@ -14,8 +14,13 @@ const { processPending } = require('../worker');
 
 const SECRET = 'whsec_test_only';
 
-function signedHeader(payload, t = 1762300800) {
-  const v1 = crypto.createHmac('sha256', SECRET).update(`${t}.${JSON.stringify(payload)}`).digest('hex');
+// What PayCo sends: Python's compact json.dumps with ensure_ascii (\u00e9, not raw é).
+function pycoBytes(payload) {
+  return Buffer.from(JSON.stringify(payload).replace(/[\u0080-\uffff]/g, (c) => '\\u' + c.charCodeAt(0).toString(16).padStart(4, '0')), 'utf8');
+}
+
+function signedHeader(raw, t = 1762300800) {
+  const v1 = crypto.createHmac('sha256', SECRET).update(Buffer.concat([Buffer.from(`${t}.`), raw])).digest('hex');
   return `t=${t},v1=${v1}`;
 }
 
