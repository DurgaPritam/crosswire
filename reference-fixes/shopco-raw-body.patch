+  assert.equal(verifySignature(raw, signedHeader(raw), 'other'), false);
+});
+
+test('regression: non-ASCII names verify over the raw escaped bytes', () => {
+  const event = { ...EVENT, data: { ...EVENT.data, customer: { id: 'cus_042', name: 'Chlo\u00e9 Martin', country: 'FR' } } };
+  const raw = pycoBytes(event);
+  assert.ok(raw.includes('\\u00e9'), 'PayCo sends the escaped form');
+  assert.equal(verifySignature(raw, signedHeader(raw), SECRET), true);
 });
 
