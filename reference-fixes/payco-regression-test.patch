+def test_regression_non_ascii_name_is_signed_over_escaped_bytes() -> None:
+    """A customer name with é must be signed over the exact bytes sent (\\u00e9, 6 bytes)."""
+    event = build_payment_succeeded("evt_0042", 4200, "EUR",
+                                    {"id": "cus_0042", "name": "Chlo\u00e9 Martin", "country": "FR"}, created=1)
+    body = serialize(event)
+    assert b"Chlo\\u00e9 Martin" in body and body.isascii()
+    header = sign(body, "s3cret", timestamp=1)
+    v1 = header.split("v1=")[1]
+    assert v1 == hmac.new(b"s3cret", b"1." + body, hashlib.sha256).hexdigest()
+    reserialized = json.dumps(json.loads(body), separators=(",", ":"), ensure_ascii=False).encode()
+    assert hmac.new(b"s3cret", b"1." + reserialized, hashlib.sha256).hexdigest() != v1, \
+        "re-serialized bytes differ, so receivers must verify the raw body"
