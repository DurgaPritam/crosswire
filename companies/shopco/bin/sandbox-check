#!/bin/sh
# Preflight's sandbox probe (`./bin/sandbox-check`), run by the agent as one allowed command, inside its OS sandbox.
# Legitimate actions must work: a temp file in .tmp/, git status, git diff.
# Canaries must be DENIED by the OS: a write into this agent's own hooks/, a read of the other company's workspace,
# a connection to the other company's evidence server. They live in this script (not on the command line) so the
# path guard can't stop them first: only the sandbox can. This file is pinned and immutable like the other controls.
cd "$(dirname "$0")/.." || exit 1
exec python3 - <<'PY'
import socket
import subprocess
from pathlib import Path

here = Path.cwd()
me = here.name
other = {"payco": "shopco", "shopco": "payco"}.get(me, "")
other_port = {"payco": 7102, "shopco": 7101}.get(me, 0)   # the OTHER company's evidence server
res = {}
try:
    (here / ".tmp").mkdir(exist_ok=True)
    (here / ".tmp" / "sandbox-check.txt").write_text("ok")
    res["tmp"] = "ok" if (here / ".tmp" / "sandbox-check.txt").read_text() == "ok" else "failed"
except OSError as exc:
    res["tmp"] = f"failed({exc.errno})"
for name, cmd in (("git_status", ["git", "status", "--short"]), ("git_diff", ["git", "diff", "--stat"])):
    r = subprocess.run(cmd, capture_output=True, text=True)
    res[name] = "ok" if r.returncode == 0 else f"failed({r.returncode})"


def denied(fn) -> str:
    try:
        fn()
        return "ALLOWED"
    except PermissionError:
        return "DENIED"
    except OSError as exc:            # EPERM / EACCES are the sandbox; anything else is inconclusive
        return "DENIED" if exc.errno in (1, 13) else f"error{exc.errno}"


res["write_hooks"] = denied(lambda: (here / "hooks" / "sandbox-canary.txt").write_text("x"))
res["read_other"] = denied(lambda: (here.parent / other / "AGENTS.md").read_text())
res["net_other"] = denied(lambda: socket.create_connection(("127.0.0.1", other_port), 2).close())
print("SANDBOX-CHECK " + " ".join(f"{k}={v}" for k, v in res.items()))
PY
