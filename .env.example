# Copy to .env (just setup does this and generates a random secret)
WEBHOOK_SECRET=change-me
PAYCO_API_PORT=7001
SHOPCO_APP_PORT=7002
PAYCO_EVIDENCE_PORT=7101
SHOPCO_EVIDENCE_PORT=7102
# Switch agent bridge base URL (NOT the Gateway URL). Probe GET /health to confirm.
SWITCH_BRIDGE_URL=http://localhost:8000
# Registration token created in Gateway for the `host` user (owner of notary)
NOTARY_REGISTRATION_TOKEN=
