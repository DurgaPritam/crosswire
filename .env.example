# Copy to .env (just setup does this and generates a random secret)
WEBHOOK_SECRET=change-me
PAYCO_API_PORT=7001
SHOPCO_APP_PORT=7002
PAYCO_EVIDENCE_PORT=7101
SHOPCO_EVIDENCE_PORT=7102
# Switch agent bridge base URL (NOT the Gateway URL). Probe GET /health to confirm.
# Console's local server picks a port; find it with `lsof -nP -iTCP -sTCP:LISTEN | grep python` and probe both.
SWITCH_BRIDGE_URL=http://127.0.0.1:50675
# Registration token created in Gateway for the `host` user (owner of notary)
NOTARY_REGISTRATION_TOKEN=
# Mattermost REST login used by spikes/run_spikes.py and scripts/rehearse.py (Phase 8).
# Port = host port of the mattermost-team-edition container (docker ps, mapped to 8065).
MM_URL=http://localhost:8065
MM_USER=
MM_PASSWORD=
